# --- Server -----------------------------------------------------------------
PORT=8788
HOST=127.0.0.1
NODE_ENV=development
DB_PATH=./data/entitygraph.db

# --- DataForSEO (primary discovery corpus, §9) ------------------------------
# Login is your account email; password is the API password from
# app.dataforseo.com/api-access, NOT your account login password.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# --- LLM extraction (§16, §65) ----------------------------------------------
# provider: anthropic | openai | heuristic
# heuristic runs the pipeline with a deterministic non-LLM extractor so nothing
# is blocked on a key; precision is materially lower.
# For a large corpus, claude-haiku-4-5 costs about a fifth of opus-5 per
# document and is usually adequate for span-level extraction. Your call.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embeddings (§19, §63) --------------------------------------------------
# provider: local | openai
# local is a deterministic dependency-free character/token hashing embedding.
# It is good enough for surface-form clustering and near-duplicate shortlisting
# and costs nothing. openai gives better semantic clustering.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Cost control (§66) -----------------------------------------------------
MAX_DOCUMENTS=4000
MAX_API_COST_USD=25
MAX_LLM_TOKENS=4000000

# --- Networking -------------------------------------------------------------
HTTP_TIMEOUT_MS=45000
PROVIDER_CACHE_TTL_S=86400
PAGE_FETCH_ENABLED=true
PAGE_FETCH_USER_AGENT=EntityGraph/1.0 (+https://example.com/bot)
EXTRA_CA_CERTS=
